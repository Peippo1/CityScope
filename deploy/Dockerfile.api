FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

WORKDIR /app

COPY pyproject.toml ./
COPY apps ./apps
COPY services ./services
COPY pipelines ./pipelines
COPY scripts/verify_deployment_artifact.py ./scripts/verify_deployment_artifact.py
COPY data/generated ./data/generated
COPY data/metadata ./data/metadata

RUN python -m pip install --no-cache-dir . && \
    python -m scripts.verify_deployment_artifact && \
    adduser --disabled-password --gecos "" --uid 10001 cityscope

USER cityscope

CMD ["sh", "-c", "exec uvicorn apps.api.app.main:app --host 0.0.0.0 --port ${PORT:-8080}"]
