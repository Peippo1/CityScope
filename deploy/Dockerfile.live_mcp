FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

WORKDIR /app

COPY services/city_live_data_mcp ./services/city_live_data_mcp

RUN python -m pip install --no-cache-dir \
        "fastapi>=0.115,<1" \
        "httpx>=0.27,<1" \
        "mcp>=1.27,<2" \
        "pydantic>=2.8,<3" \
        "uvicorn[standard]>=0.30,<1" && \
    adduser --disabled-password --gecos "" --uid 10001 cityscope

USER cityscope

CMD ["sh", "-c", "exec uvicorn services.city_live_data_mcp.server:app --host 0.0.0.0 --port ${PORT:-8080}"]
