FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
WORKDIR /app
COPY pyproject.toml ./
COPY apps ./apps
COPY services ./services
COPY pipelines ./pipelines
COPY data/generated ./data/generated
COPY data/metadata ./data/metadata
RUN python -m pip install --no-cache-dir . && adduser --disabled-password --gecos "" --uid 10001 cityscope
USER cityscope
CMD ["sh", "-c", "exec uvicorn services.city_live_data_mcp.server:app --host 0.0.0.0 --port ${PORT:-8080}"]
