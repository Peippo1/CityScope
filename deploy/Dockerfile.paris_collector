FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
WORKDIR /app
COPY services ./services
COPY scripts/archive_paris_status.py ./scripts/archive_paris_status.py
RUN python -m pip install --no-cache-dir "httpx>=0.27,<1" "pydantic>=2.8,<3" "google-cloud-storage>=2.18,<4" && adduser --disabled-password --gecos "" --uid 10001 cityscope
USER cityscope
CMD ["python", "-m", "scripts.archive_paris_status"]
