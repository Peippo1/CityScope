# API CORS allowlist for the local/deployed web origin. A local origin also
# permits localhost and 127.0.0.1 fallback ports selected by the dev server.
CITYSCOPE_WEB_ORIGIN=http://localhost:3000
# Comma-separated Host header allowlist. Set the deployed API hostname on Cloud Run.
CITYSCOPE_TRUSTED_HOSTS=localhost,127.0.0.1

# Private server-to-server connection used by the investigation agent.
CITYSCOPE_CITY_DATA_MCP_URL=http://localhost:8001/mcp/
# Set to the private MCP Cloud Run service URL so the API attaches an identity token.
CITYSCOPE_CITY_DATA_MCP_ID_TOKEN_AUDIENCE=
# Private live Paris MCP. Set its Cloud Run service URL as the audience in production.
CITYSCOPE_CITY_LIVE_DATA_MCP_URL=http://localhost:8002/mcp/
CITYSCOPE_CITY_LIVE_DATA_MCP_ID_TOKEN_AUDIENCE=
# Required only by the hourly Cloud Run archival job, never by the browser or API.
CITYSCOPE_PARIS_ARCHIVE_BUCKET=
# Optional fixed-feed overrides for controlled testing. Production uses the two vetted defaults.
# CITYSCOPE_VELIB_STATUS_URL=
# CITYSCOPE_VELIB_INFORMATION_URL=
GEMINI_API_KEY=
# CITYSCOPE_GEMINI_MODEL=gemini-3.5-flash

# Private backend credential for https://mapstools.googleapis.com/mcp.
GOOGLE_MAPS_GROUNDING_API_KEY=
# CITYSCOPE_MAPS_MCP_URL=https://mapstools.googleapis.com/mcp

# Private server-side Google Routes API key for deterministic bicycle routing.
GOOGLE_ROUTES_API_KEY=
# CITYSCOPE_ROUTES_API_URL=https://routes.googleapis.com/directions/v2:computeRoutes

# Sanitized metadata telemetry. LangSmith remains optional and disabled by default.
CITYSCOPE_TELEMETRY=local
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=cityscope
LANGSMITH_SAMPLE_RATE=0.0

# Firebase Admin uses Cloud Run's service account; never place a service-account key in the repo.
FIREBASE_PROJECT_ID=

# Browser key must be restricted by HTTP referrer and enabled APIs in Google Cloud.
# NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
